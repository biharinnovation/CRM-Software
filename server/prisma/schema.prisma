generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  ACCOUNT_MANAGER
  FINANCE_MANAGER
  MARKETING_MANAGER
  HR
  EMPLOYEE
  CLIENT
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  INTERN
  FREELANCER
  CONTRACT
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_CALL
  EMAIL_CAMPAIGN
  ADVERTISEMENT
  EVENT
  PARTNER
  OTHER
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum ProjectStatus {
  DUE_SIGNING
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum Currency {
  INR
  USD
  EUR
}

// ─── User Model ──────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  password        String
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  phone           String?
  avatar          String?
  role            Role       @default(EMPLOYEE)
  status          UserStatus @default(ACTIVE)
  emergencyContactNumber String? @map("emergency_contact_number")
  address         String?    @db.Text
  employeeType    EmployeeType @default(FULL_TIME) @map("employee_type")
  employeeTypeOther String?   @map("employee_type_other")
  // Biometric device enroll number (maps device punches → this user)
  biometricCode   Int?       @unique @map("biometric_code")
  // Monthly base pay (payroll). In INR (base currency).
  basePay         Decimal?   @map("base_pay") @db.Decimal(12, 2)
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Refresh tokens
  refreshTokens RefreshToken[]

  // Audit trail
  auditLogs AuditLog[] @relation("AuditUser")

  // Leads
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads  Lead[] @relation("LeadCreator")

  // Deals
  assignedDeals Deal[] @relation("DealAssignee")
  createdDeals  Deal[] @relation("DealCreator")

  // Clients
  managedClients Client[] @relation("ClientAccountManager")

  // Client portal — links CLIENT-role users to their company
  clientId       String?  @map("client_id")
  client         Client?  @relation("ClientPortalUsers", fields: [clientId], references: [id])

  // Reporting manager (self relation)
  reportingManagerId String? @map("reporting_manager_id")
  reportingManager   User?   @relation("UserReportingManager", fields: [reportingManagerId], references: [id])
  reportingDirectReports User[] @relation("UserReportingManager")

  // Projects
  managedProjects Project[] @relation("ProjectAccountManager")
  createdProjects Project[] @relation("ProjectCreator")

  // OTPs
  otps Otp[]

  // Teams
  ledTeams       Team[]       @relation("TeamLead")
  teamMembers    TeamMember[]

  // Notifications
  notifications  Notification[]

  // Documents
  documents      Document[] @relation("DocumentCreator")
  employeeDocuments Document[] @relation("EmployeeDocument")

  // Meetings
  createdMeetings Meeting[] @relation("MeetingCreator")

  // Follow-ups
  createdFollowUps FollowUp[] @relation("FollowUpCreator")

  // Samples
  createdSamples Sample[] @relation("SampleCreator")

  // Planning, Tasks, Milestones
  createdPlanningSteps PlanningStep[] @relation("PlanningStepCreator")
  assignedTasks        Task[]         @relation("TaskAssignee")
  delegatedTasks       Task[]         @relation("TaskAssigner")
  createdTasks         Task[]         @relation("TaskCreator")
  reviewedTasks        Task[]         @relation("TaskReviewer")
  createdMilestones    Milestone[]    @relation("MilestoneCreator")
  taskFeedbacks        TaskFeedback[] @relation("TaskFeedbackGiver")
  taskSubmissions      TaskSubmission[] @relation("TaskSubmitter")

  // Expenses
  submittedExpenses    Expense[]      @relation("ExpenseSubmitter")
  reviewedExpenses     Expense[]      @relation("ExpenseReviewer")
  paidExpenses         Expense[]      @relation("ExpensePayer")
  expenseEvents        ExpenseEvent[] @relation("ExpenseEventActor")

  // Marketing
  managedCampaigns     Campaign[]          @relation("CampaignManager")
  createdCampaigns     Campaign[]          @relation("CampaignCreator")
  campaignDailyStats   CampaignDailyStat[] @relation("CampaignStatAuthor")
  approvedAdBudgets    AdBudgetEntry[]     @relation("AdBudgetApprover")
  createdAdBudgets     AdBudgetEntry[]     @relation("AdBudgetCreator")

  // Comments
  comments             Comment[]      @relation("CommentAuthor")

  // Attendance & leaves
  attendance        Attendance[]    @relation("UserAttendance")
  markedAttendance  Attendance[]    @relation("AttendanceMarker")
  leaveBalances     LeaveBalance[]  @relation("UserLeaveBalance")
  leaveRequests     LeaveRequest[]  @relation("UserLeaveRequest")
  reviewedLeaves    LeaveRequest[]  @relation("LeaveReviewer")

  // Copilot
  copilotConversations CopilotConversation[]

  // Invoices created
  createdInvoices Invoice[] @relation("InvoiceCreator")
  recordedPayments InvoicePayment[] @relation("InvoicePaymentRecorder")
  projectReports   ProjectReport[]  @relation("ProjectReportAuthor")
  projectCycles    ProjectCycle[]   @relation("ProjectCycleCreator")

  // Announcements created
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")

  // Jobs created
  createdJobs Job[] @relation("JobCreator")

  // Payroll records
  payrollRecords PayrollRecord[] @relation("PayrollUser")

  // Deliverables
  createdDeliverables Deliverable[] @relation("DeliverableCreator")
  deliverableFeedbacks DeliverableFeedback[] @relation("DeliverableFeedbackAuthor")

  @@index([clientId])
  @@index([reportingManagerId])
  @@map("users")
}

// ─── Refresh Token ───────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Audit Log ───────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Lead ────────────────────────────────────────────────

model Lead {
  id            String       @id @default(cuid())
  companyName   String       @map("company_name")
  contactName   String       @map("contact_name")
  email         String?
  phone         String?
  source        LeadSource   @default(OTHER)
  status        LeadStatus   @default(NEW)
  priority      LeadPriority @default(MEDIUM)
  estimatedValue Decimal?    @map("estimated_value") @db.Decimal(12, 2)
  notes         String?
  lostReason    String?      @map("lost_reason")

  // Assigned sales person
  assigneeId    String?      @map("assignee_id")
  assignee      User?        @relation("LeadAssignee", fields: [assigneeId], references: [id])

  // Who created this lead
  createdById   String       @map("created_by_id")
  createdBy     User         @relation("LeadCreator", fields: [createdById], references: [id])

  // Campaign that produced this lead. First-touch: set at creation, and only
  // marketing or an admin may change it afterwards.
  campaignId    String?      @map("campaign_id")
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Converted deal
  deal Deal?

  // Meetings
  meetings Meeting[]

  // Follow-ups
  followUps FollowUp[]

  // Samples
  leadSamples LeadSample[]

  // Duplicate prevention
  @@unique([email, companyName], map: "leads_email_company_unique")

  followUpAt    DateTime?    @map("follow_up_at")
  convertedAt   DateTime?    @map("converted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([assigneeId])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

// ─── Deal ────────────────────────────────────────────────

model Deal {
  id              String    @id @default(cuid())
  title           String
  value           Decimal?  @db.Decimal(12, 2)
  stage           DealStage @default(DISCOVERY)
  expectedCloseAt DateTime? @map("expected_close_at")
  lostReason      String?   @map("lost_reason")
  notes           String?

  // Source lead
  leadId          String    @unique @map("lead_id")
  lead            Lead      @relation(fields: [leadId], references: [id])
  followUps       FollowUp[]

  // Assigned sales person
  assigneeId      String?   @map("assignee_id")
  assignee        User?     @relation("DealAssignee", fields: [assigneeId], references: [id])

  // Who created this deal
  createdById     String    @map("created_by_id")
  createdBy       User      @relation("DealCreator", fields: [createdById], references: [id])

  // Converted client + project
  client          Client?
  project         Project?

  // Services attached to this deal
  dealServices    DealService[]

  // Documents (proposals, etc.)
  documents       Document[]

  // Meetings
  meetings        Meeting[]

  // Samples
  dealSamples     DealSample[]

  wonAt           DateTime? @map("won_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([stage])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("deals")
}

// ─── Client ──────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  companyName     String       @map("company_name")
  contactName     String       @map("contact_name")
  email           String?      @unique
  phone           String?
  address         String?
  industry        String?
  website         String?
  logo            String?
  status          ClientStatus @default(ACTIVE)
  notes           String?

  // Source deal
  dealId          String?      @unique @map("deal_id")
  deal            Deal?        @relation(fields: [dealId], references: [id])

  // Account manager
  accountManagerId String?     @map("account_manager_id")
  accountManager   User?       @relation("ClientAccountManager", fields: [accountManagerId], references: [id])

  // Portal users — CLIENT-role users linked to this company
  portalUsers     User[]       @relation("ClientPortalUsers")

  // Projects under this client
  projects        Project[]

  // Documents
  documents       Document[]

  // Invoices
  invoices        Invoice[]

  expenses    Expense[]

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([accountManagerId])
  @@map("clients")
}

// ─── Project ─────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus @default(NOT_STARTED)
  startDate       DateTime?     @map("start_date")
  endDate         DateTime?     @map("end_date")
  budget          Decimal?      @db.Decimal(12, 2)
  notes           String?

  // Recurring billing
  billingCycle    BillingCycle  @default(ONE_TIME) @map("billing_cycle")
  nextBillingDate DateTime?     @map("next_billing_date")

  // Parent client
  clientId        String        @map("client_id")
  client          Client        @relation(fields: [clientId], references: [id])

  // Source deal (optional — projects can be created manually too)
  dealId          String?       @unique @map("deal_id")
  deal            Deal?         @relation(fields: [dealId], references: [id])

  // Account manager for this project
  accountManagerId String?      @map("account_manager_id")
  accountManager   User?        @relation("ProjectAccountManager", fields: [accountManagerId], references: [id])

  // Creator
  createdById     String        @map("created_by_id")
  createdBy       User          @relation("ProjectCreator", fields: [createdById], references: [id])

  // Services attached to this project
  projectServices ProjectService[]

  // Teams assigned to this project
  projectTeams    ProjectTeam[]

  // Documents
  documents       Document[]

  // Meetings
  meetings        Meeting[]

  // Planning, Tasks, Milestones
  planningSteps   PlanningStep[]
  tasks           Task[]
  milestones      Milestone[]

  // Invoices
  invoices        Invoice[]

  // Deliverables
  deliverables    Deliverable[]

  expenses    Expense[]
  campaigns   Campaign[]
  reports     ProjectReport[]
  cycles      ProjectCycle[]
  adBudgets   AdBudgetLedger[]

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([status])
  @@index([accountManagerId])
  @@index([billingCycle])
  @@index([createdAt])
  @@map("projects")
}

// ─── Service ─────────────────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  price           Decimal  @db.Decimal(12, 2)
  salePrice       Decimal? @map("sale_price") @db.Decimal(12, 2)
  points          Json?    // Array of strings: ["Logo Design", "Brand Book", ...]
  isActive        Boolean  @default(true) @map("is_active")

  // Relations
  dealServices    DealService[]
  projectServices ProjectService[]
  packageItems    PackageService[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("services")
}

// ─── Service Packages ────────────────────────────────────
// A named bundle of services (e.g. "Gold Plan") that can be added to a deal
// or project in one action — every service in it is added individually, so
// each line stays as editable afterward as if it had been added by hand.

model ServicePackage {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  items           PackageService[]
  dealServices    DealService[]
  projectServices ProjectService[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("service_packages")
}

// One service inside a package, with an optional price that overrides the
// service's own price/salePrice just for this package.
model PackageService {
  id            String   @id @default(cuid())
  packageId     String   @map("package_id")
  serviceId     String   @map("service_id")
  quantity      Int      @default(1)
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([packageId])
  @@index([serviceId])
  @@map("package_services")
}

// ─── Deal ↔ Service (many-to-many) ──────────────────────

model DealService {
  id            String  @id @default(cuid())
  dealId        String  @map("deal_id")
  serviceId     String  @map("service_id")
  quantity      Int     @default(1)
  price         Decimal @db.Decimal(12, 2) // editable snapshot price
  originalPrice Decimal @db.Decimal(12, 2) @map("original_price") // service price at time of linking
  // Set when this row was added as part of a package, so the UI can group it
  // and offer "remove the whole plan". Editing price/quantity afterward is
  // unaffected — it behaves exactly like a service added by hand.
  packageId     String? @map("package_id")

  deal      Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([dealId, serviceId])
  @@index([dealId])
  @@index([serviceId])
  @@index([packageId])
  @@map("deal_services")
}

// ─── Project ↔ Service (many-to-many) ───────────────────

model ProjectService {
  id            String  @id @default(cuid())
  projectId     String  @map("project_id")
  serviceId     String  @map("service_id")
  quantity      Int     @default(1)
  price         Decimal @db.Decimal(12, 2) // editable snapshot price
  originalPrice Decimal @db.Decimal(12, 2) @map("original_price") // service price at time of linking
  // Set when this row was added as part of a package — see DealService.packageId.
  packageId     String? @map("package_id")
  // Manual display order, drag-reordered on the project's Services card.
  position      Int     @default(0)

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, serviceId])
  @@index([projectId])
  @@index([serviceId])
  @@index([packageId])
  @@map("project_services")
}

// ─── Invoice ─────────────────────────────────────────────
// Per-project invoice. Line items are snapshots — an invoice is immutable
// history; editing the project's services later does not change past invoices.

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  // Human-friendly sequential number, e.g. "INV-2026-0001"
  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)

  // Parent project + client (snapshotted for stable display)
  projectId     String        @map("project_id")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Snapshot of bill-to details at issue time
  billToName    String?       @map("bill_to_name")
  billToEmail   String?       @map("bill_to_email")
  billToAddress String?       @map("bill_to_address") @db.Text

  // Currency snapshot (values stored in this currency, no conversion later)
  currency      Currency      @default(INR)

  // Money — all snapshot amounts in `currency`
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)

  // GST split. Each rate is independently overrideable per invoice, defaulting
  // from Settings. taxPercent/taxAmount stay as the combined total of the
  // three, so anything reading only those two fields (PDF total maths, the
  // email summary) keeps working unchanged.
  cgstPercent   Decimal       @default(0) @map("cgst_percent") @db.Decimal(5, 2)
  sgstPercent   Decimal       @default(0) @map("sgst_percent") @db.Decimal(5, 2)
  igstPercent   Decimal       @default(0) @map("igst_percent") @db.Decimal(5, 2)
  cgstAmount    Decimal       @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount    Decimal       @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount    Decimal       @default(0) @map("igst_amount") @db.Decimal(12, 2)
  taxPercent    Decimal       @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)

  /// Outstanding balance carried forward from the project's previous invoice
  /// (its total minus what it had received, at the time THIS invoice was
  /// created). Not taxed — added straight onto the grand total. Suggested
  /// automatically when the invoice is created, but always overrideable.
  previousDueAmount Decimal   @default(0) @map("previous_due_amount") @db.Decimal(12, 2)

  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)

  // Dates
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  paidAt        DateTime?     @map("paid_at")

  notes         String?       @db.Text
  terms         String?       @db.Text

  // Line items (snapshots)
  items         InvoiceItem[]

  // Creator
  createdById   String        @map("created_by_id")
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id])

  /// Chosen payment account, and a snapshot of its details. The snapshot is
  /// what the client was actually told to pay into — editing or deactivating
  /// the account later must not rewrite an invoice already sent.
  paymentAccountId String?         @map("payment_account_id")
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paymentDetails   Json?           @map("payment_details")

  payments InvoicePayment[]

  /// Soft delete. An invoice is never hard-deleted — it is financial history,
  /// and its number must never be reused. An inactive invoice drops out of
  /// every total, cannot be edited, paid or sent, and is visible only to
  /// OWNER and ADMIN.
  isActive           Boolean   @default(true) @map("is_active")
  deactivatedAt      DateTime? @map("deactivated_at")
  deactivatedById    String?   @map("deactivated_by_id")
  deactivationReason String?   @map("deactivation_reason") @db.Text

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([isActive])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Snapshot of the service / line at issue time (not a live FK)
  name        String
  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2) // quantity * unitPrice
  position    Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─── Site Configuration ──────────────────────────────────
// Single-row table — only one record (id = "default")

model Site {
  id                String   @id @default("default")
  name              String   @default("TaskGo Agency")
  logo              String?  @default("/logo.svg")
  contactEmail      String?  @default("mails.kunalbhatia@gmail.com") @map("contact_email")
  contactPhone      String?  @default("+91 82848-34841") @map("contact_phone")
  address           String?  @default("Chandigarh, India")

  // Currency configuration
  currency          Currency @default(INR)
  usdToInr          Decimal  @default(92)  @map("usd_to_inr") @db.Decimal(10, 4)
  eurToInr          Decimal  @default(105) @map("eur_to_inr") @db.Decimal(10, 4)

  isMaintenanceMode Boolean  @default(false) @map("is_maintenance_mode")
  isDemoMode        Boolean  @default(false) @map("is_demo_mode")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("site")
}

// ─── Settings ────────────────────────────────────────────
// Single-row table for system-wide settings

model Settings {
  id              String  @id @default("default")

  // SMTP Configuration
  smtpHost        String? @map("smtp_host")
  smtpPort        Int?    @map("smtp_port")
  smtpEmail       String? @map("smtp_email")
  smtpPassword    String? @map("smtp_password")
  smtpIsSecure    Boolean @default(true) @map("smtp_is_secure")

  // OTP Login Configuration
  otpLoginEnabled Boolean @default(false) @map("otp_login_enabled")
  otpDigits       Int     @default(6)     @map("otp_digits")
  otpExpiryMins   Int     @default(5)     @map("otp_expiry_mins")

  // Storage Configuration
  // Provider: LOCAL | S3 | R2 | CUSTOM
  storageProvider       String  @default("LOCAL") @map("storage_provider")
  // S3/R2 config (both use S3-compatible API)
  storageAccessKeyId    String? @map("storage_access_key_id")
  storageSecretKey      String? @map("storage_secret_key")
  storageEndpoint       String? @map("storage_endpoint")       // e.g. https://<account>.r2.cloudflarestorage.com
  storageRegion         String? @map("storage_region")         // e.g. us-east-1, auto
  storageBucket         String? @map("storage_bucket")
  storagePublicUrl      String? @map("storage_public_url")     // NEXT_PUBLIC_STORAGE_URL — CDN / public bucket URL
  // Custom provider config
  storageCustomPostUrl  String? @map("storage_custom_post_url")  // URL to POST files to
  storageCustomFileKey  String? @map("storage_custom_file_key")  // Form field name for the file (e.g. "file")
  storageCustomUrlKey   String? @map("storage_custom_url_key")   // JSON response key that holds the file URL (e.g. "url")

  // Attendance Configuration
  // Day-of-week numbers treated as weekend (0 = Sunday … 6 = Saturday)
  weekendDays       Int[]   @default([0, 6]) @map("weekend_days")

  // Invoice Configuration
  invoiceBgImage          String?  @map("invoice_bg_image")                          // background/watermark URL
  invoiceBgOpacity        Float    @default(0.05) @map("invoice_bg_opacity")         // 0.0 - 1.0
  invoiceDefaultTaxPercent Decimal @default(0) @map("invoice_default_tax_percent") @db.Decimal(5, 2)
  invoiceDefaultCgstPercent Decimal @default(0) @map("invoice_default_cgst_percent") @db.Decimal(5, 2)
  invoiceDefaultSgstPercent Decimal @default(0) @map("invoice_default_sgst_percent") @db.Decimal(5, 2)
  invoiceDefaultIgstPercent Decimal @default(0) @map("invoice_default_igst_percent") @db.Decimal(5, 2)
  invoiceDefaultDiscount  Decimal  @default(0) @map("invoice_default_discount") @db.Decimal(12, 2)
  invoiceDefaultNotes     String?  @map("invoice_default_notes") @db.Text
  invoiceDefaultTerms     String?  @map("invoice_default_terms") @db.Text

  // AI Configuration
  aiProvider        String  @default("NONE") @map("ai_provider")       // NONE | GEMINI | OPENAI | CUSTOM
  aiApiKey          String? @map("ai_api_key")
  aiModel           String? @map("ai_model")                           // e.g. gemini-2.0-flash, gpt-4o-mini
  aiBaseUrl         String? @map("ai_base_url")                        // Custom provider endpoint
  aiTemperature     Float   @default(0.7) @map("ai_temperature")       // 0.0 - 2.0
  aiMaxTokens       Int     @default(4096) @map("ai_max_tokens")
  // Live web search (OpenAI's hosted tool). Off by default: every search is
  // billed per call on top of the model, so it stays an explicit opt-in.
  aiWebSearchEnabled Boolean @default(false) @map("ai_web_search_enabled")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── System Prompt ───────────────────────────────────
// Reusable AI prompts for different features

model SystemPrompt {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  prompt       String  @db.Text
  responseSchema String? @map("response_schema") @db.Text  // JSON Schema for structured output
  isActive     Boolean @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("system_prompts")
}

// ─── OTP (One-Time Password) ─────────────────────────
// Stores pending OTP codes for login verification

model Otp {
  id        String   @id @default(cuid())
  code      String
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otps")
}

// ─── Team ────────────────────────────────────────────
// Teams group employees together for projects

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  avatar      String?

  // Team lead (label only, not enforced as a permission)
  leadId      String?  @map("lead_id")
  lead        User?    @relation("TeamLead", fields: [leadId], references: [id])

  // Members
  members     TeamMember[]

  // Projects this team is assigned to
  projectTeams ProjectTeam[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([createdAt])
  @@map("teams")
}

// ─── Team Member ─────────────────────────────────────
// Junction table: User ↔ Team with permissions

model TeamMember {
  id          String @id @default(cuid())
  teamId      String @map("team_id")
  userId      String @map("user_id")

  // Permissions (dummy for now — JSON object for flexibility)
  permissions Json?  @default("{}")

  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// ─── Project ↔ Team (many-to-many) ──────────────────

model ProjectTeam {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  teamId    String  @map("team_id")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
  @@map("project_teams")
}

// ─── Announcement ────────────────────────────────────
// HR/Owner broadcast to staff. Persisted for history; also fans out to
// per-user Notifications on create.

enum AnnouncementAudience {
  ALL            // all active non-CLIENT users
  EMPLOYEES      // EMPLOYEE role only
  MANAGERS       // manager roles (SALES/ACCOUNT/FINANCE managers)
  HR
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  isPinned    Boolean              @default(false) @map("is_pinned")

  createdById String               @map("created_by_id")
  createdBy   User                 @relation("AnnouncementCreator", fields: [createdById], references: [id])

  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("announcements")
}

// ─── Notification ────────────────────────────────────

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LEAD
  DEAL
  CLIENT
  PROJECT
  TEAM
  SERVICE
  USER
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

model Notification {
  id          String             @id @default(cuid())
  title       String
  description String             @db.Text
  type        NotificationType   @default(INFO)
  channel     NotificationChannel @default(IN_APP)
  isRead      Boolean            @default(false) @map("is_read")
  readAt      DateTime?          @map("read_at")
  emailSent   Boolean            @default(false) @map("email_sent")
  linkUrl     String?            @map("link_url")

  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Document ────────────────────────────────────────

enum DocumentType {
  PROPOSAL
  AGREEMENT
  NDA
  INVOICE
  CONTRACT
  REPORT
  OTHER
}

model Document {
  id          String       @id @default(cuid())
  name        String
  type        DocumentType @default(PROPOSAL)
  version     Int          @default(1)
  fileUrl     String       @map("file_url")
  fileKey     String?      @map("file_key")
  mimeType    String?      @map("mime_type")
  fileSize    Int?         @map("file_size")
  description String?      @db.Text
  isAiGenerated    Boolean    @default(false) @map("is_ai_generated")
  requiresSignature Boolean   @default(false) @map("requires_signature")
  isSigned          Boolean   @default(false) @map("is_signed")
  signedAt          DateTime? @map("signed_at")

  // Optional relations
  dealId      String?      @map("deal_id")
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  clientId    String?      @map("client_id")
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId   String?      @map("project_id")
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId      String?      @map("user_id")
  user        User?        @relation("EmployeeDocument", fields: [userId], references: [id], onDelete: SetNull)

  // Who uploaded/created this document
  addedById   String       @map("added_by_id")
  addedBy     User         @relation("DocumentCreator", fields: [addedById], references: [id])

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([dealId])
  @@index([clientId])
  @@index([projectId])
  @@index([userId])
  @@index([addedById])
  @@index([type])
  @@index([createdAt])
  @@map("documents")
}

// ─── Meeting ─────────────────────────────────────────

enum MeetingMode {
  VIRTUAL
  IN_PERSON
  PHONE_CALL
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingPhase {
  REGULAR
  KICKOFF
  PRE_PRODUCTION
  POST_PRODUCTION
  REVIEW
}

model Meeting {
  id              String        @id @default(cuid())
  title           String
  description     String?       @db.Text
  mode            MeetingMode   @default(VIRTUAL)
  status          MeetingStatus @default(SCHEDULED)
  phase           MeetingPhase  @default(REGULAR) @map("phase")
  link            String?       // Meet link, phone number, or place
  scheduledAt     DateTime      @map("scheduled_at")
  duration        Int?          // Duration in minutes
  notes           String?       @db.Text
  outcome         String?       @db.Text
  // Structured requirements captured in this meeting (esp. pre-production).
  // Shape: Array<{ title: string, description?: string, priority?: "LOW"|"MEDIUM"|"HIGH"|"URGENT" }>
  requirements    Json?
  isFollowUp      Boolean       @default(false) @map("is_follow_up")
  parentMeetingId String?       @map("parent_meeting_id")
  parentMeeting   Meeting?      @relation("MeetingFollowUps", fields: [parentMeetingId], references: [id], onDelete: SetNull)
  followUpMeetings Meeting[]    @relation("MeetingFollowUps")

  // Polymorphic: attach to lead, deal, or project
  leadId          String?       @map("lead_id")
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dealId          String?       @map("deal_id")
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  projectId       String?       @map("project_id")
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Tasks linked to this meeting (for pre-production briefing or post-production review)
  meetingTasks    MeetingTask[]

  // Who created this meeting
  createdById     String        @map("created_by_id")
  createdBy       User          @relation("MeetingCreator", fields: [createdById], references: [id])

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([dealId])
  @@index([projectId])
  @@index([status])
  @@index([phase])
  @@index([scheduledAt])
  @@index([createdById])
  @@map("meetings")
}

// ─── MeetingTask (junction) ──────────────────────────
// Links meetings to specific tasks — e.g. which tasks were briefed in a pre-production
// meeting, or which tasks were reviewed in a post-production meeting.

model MeetingTask {
  id        String   @id @default(cuid())
  meetingId String   @map("meeting_id")
  taskId    String   @map("task_id")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([meetingId, taskId])
  @@index([meetingId])
  @@index([taskId])
  @@map("meeting_tasks")
}

// ─── Lead Follow-Up ──────────────────────────────────

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  TASK
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SKIPPED
  OVERDUE
}

model FollowUp {
  id          String         @id @default(cuid())
  title       String
  type        FollowUpType   @default(CALL)
  status      FollowUpStatus @default(PENDING)
  dueAt       DateTime       @map("due_at")
  completedAt DateTime?      @map("completed_at")
  notes       String?        @db.Text
  outcome     String?        @db.Text

  // Parent record: a follow-up hangs off exactly one of a lead or a deal.
  // Both are optional at the column level; the service enforces the either/or.
  leadId      String?        @map("lead_id")
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dealId      String?        @map("deal_id")
  deal        Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Who created this follow-up
  createdById String         @map("created_by_id")
  createdBy   User           @relation("FollowUpCreator", fields: [createdById], references: [id])

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([dueAt])
  @@index([createdById])
  @@map("follow_ups")
}

// ─── Sample ─────────────────────────────────────────
// Work samples / portfolio pieces shared with leads & deals

model Sample {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  links       Json     @default("[]") // Array of { label, url } objects

  // Who created this sample
  createdById String   @map("created_by_id")
  createdBy   User     @relation("SampleCreator", fields: [createdById], references: [id])

  // Junction tables
  leadSamples LeadSample[]
  dealSamples DealSample[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("samples")
}

// ─── Lead ↔ Sample (many-to-many) ──────────────────

model LeadSample {
  id       String @id @default(cuid())
  leadId   String @map("lead_id")
  sampleId String @map("sample_id")

  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([leadId, sampleId])
  @@index([leadId])
  @@index([sampleId])
  @@map("lead_samples")
}

// ─── Deal ↔ Sample (many-to-many) ──────────────────

model DealSample {
  id       String @id @default(cuid())
  dealId   String @map("deal_id")
  sampleId String @map("sample_id")

  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([dealId, sampleId])
  @@index([dealId])
  @@index([sampleId])
  @@map("deal_samples")
}

// ─── Email Template ──────────────────────────────────
// System email templates managed by the admin

model EmailTemplate {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  subject     String
  body        String  @db.Text
  description String?
  variables   String? @db.Text

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// ─── Planning Steps ──────────────────────────────────
// Phases/stages within a project plan

enum PlanningStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model PlanningStep {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  status      PlanningStepStatus @default(PENDING)
  position    Int                @default(0)
  startDate   DateTime?          @map("start_date")
  endDate     DateTime?          @map("end_date")

  projectId   String             @map("project_id")
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Delivery period this belongs to. Null for records made before cycles
  /// existed, and for projects that never had one.
  cycleId     String?       @map("cycle_id")
  cycle       ProjectCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  createdById String             @map("created_by_id")
  createdBy   User               @relation("PlanningStepCreator", fields: [createdById], references: [id])

  tasks       Task[]
  deliverables DeliverablePlanningStep[]

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([position])
  @@map("planning_steps")
}

// ─── Task Cost Type ──────────────────────────────────

enum TaskCostType {
  HOUR
  DAY
  MONTH
  NONE
}

// ─── Tasks ───────────────────────────────────────────

enum TaskStatus {
  NEW           // created, assignee has not looked at it
  ACKNOWLEDGED  // assignee has seen it
  IN_PROGRESS   // assignee is working on it
  IN_REVIEW     // handed in, waiting on manager / team lead
  CLIENT_REVIEW // approved internally, waiting on the client
  COMPLETED     // signed off
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  // Creative goal — what this task aims to produce / achieve
  objectives  String?      @db.Text
  // What will be delivered (shots, edits, designs, etc.)
  deliverables String?     @db.Text
  // References: array of { label: string, url: string } — mood boards, examples, briefs
  references  Json?
  status      TaskStatus   @default(NEW)
  priority    TaskPriority @default(MEDIUM)
  position    Int          @default(0)
  internalCostAmount Decimal? @map("internal_cost_amount") @db.Decimal(12, 2)
  internalCostType   TaskCostType @default(NONE) @map("internal_cost_type")
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")
  reviewedAt  DateTime?    @map("reviewed_at")

  projectId   String       @map("project_id")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Delivery period this belongs to. Null for records made before cycles
  /// existed, and for projects that never had one.
  cycleId     String?       @map("cycle_id")
  cycle       ProjectCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  // Optional: task can belong to a planning step
  planningStepId String?   @map("planning_step_id")
  planningStep   PlanningStep? @relation(fields: [planningStepId], references: [id], onDelete: SetNull)

  // Optional: task can be linked to a milestone
  milestoneId String?      @map("milestone_id")
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  // Assignee — must be a member of a team assigned to the project
  assigneeId  String?      @map("assignee_id")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // Who handed this task to the current assignee — lets a team lead take a
  // task and delegate it onward while keeping the trail visible.
  assignedById String?     @map("assigned_by_id")
  assignedBy   User?       @relation("TaskAssigner", fields: [assignedById], references: [id])

  // Who reviewed/approved
  reviewedById String?     @map("reviewed_by_id")
  reviewedBy   User?       @relation("TaskReviewer", fields: [reviewedById], references: [id])

  createdById String       @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])

  // Follow-up / child tasks
  parentTaskId String?      @map("parent_task_id")
  parentTask   Task?        @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks   Task[]       @relation("TaskChildren")

  // Meetings linked to this task (pre-production briefing, post-production review, etc.)
  meetingTasks MeetingTask[]

  feedbacks   TaskFeedback[]
  submissions TaskSubmission[]
  linkedDeliverables DeliverableTask[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([planningStepId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}
// ─── Project Reports ─────────────────────────────────

enum ProjectReportStatus {
  DRAFT
  FINAL
}

/// A monthly client audit report for one project.
///
/// `snapshot` is frozen at generation time — August's report must not change
/// because September's data arrived. `overrides` holds hand-entered values in a
/// separate layer, so the auto figure survives underneath and any manual edit
/// can be reverted.
model ProjectReport {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  periodYear  Int @map("period_year")
  periodMonth Int @map("period_month")   // 1-12

  status ProjectReportStatus @default(DRAFT)

  /// Auto-pulled data, section by section.
  snapshot  Json
  /// Manual edits keyed by "section.field" path.
  overrides Json?
  /// Free-text summary written by whoever signs the report off.
  summary   String? @db.Text

  generatedById String   @map("generated_by_id")
  generatedBy   User     @relation("ProjectReportAuthor", fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now()) @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, periodYear, periodMonth])
  @@index([projectId])
  @@map("project_reports")
}

// ─── Invoice Payments ────────────────────────────────

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

/// One receipt against an invoice. Recorded rather than derived, so partial
/// payments keep their own reference numbers and audit trail — `amountPaid` on
/// the invoice is recomputed from these.
model InvoicePayment {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  paidAt DateTime      @map("paid_at")

  /// The number a client would quote: UTR, transaction id, cheque number.
  referenceNo String? @map("reference_no")
  /// Method-specific extras — cheque bank and date, UPI id, card last four.
  details     Json?
  note        String? @db.Text

  recordedById String @map("recorded_by_id")
  recordedBy   User   @relation("InvoicePaymentRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_payments")
}

// ─── Payment Accounts ────────────────────────────────

enum PaymentAccountType {
  BANK
  UPI
}

/// Where clients send money. Multiple accounts can exist; one is picked per
/// invoice, and its details are snapshotted onto that invoice at issue time.
model PaymentAccount {
  id    String             @id @default(cuid())
  type  PaymentAccountType
  label String                              // "HDFC Current", "Business UPI"

  // BANK
  bankName          String? @map("bank_name")
  accountNumber     String? @map("account_number")
  ifscCode          String? @map("ifsc_code")
  accountHolderName String? @map("account_holder_name")
  branch            String?

  // UPI
  upiId   String? @map("upi_id")
  upiName String? @map("upi_name")
  /// Starts the invoice number for invoices billed to this account, so each
  /// account keeps its own series: "INV-2026-0001", "ABC-2026-0001".
  invoicePrefix String @default("INV") @map("invoice_prefix")

  isActive  Boolean @default(true) @map("is_active")
  /// Pre-selected when a new invoice is created.
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_accounts")
}

// ─── Marketing: Campaigns & Ad Budget ────────────────

enum CampaignPlatform {
  META
  GOOGLE_ADS
  LINKEDIN
  YOUTUBE
  INSTAGRAM
  EMAIL
  SEO
  OTHER
}

enum CampaignObjective {
  LEAD_GENERATION
  BRAND_AWARENESS
  TRAFFIC
  ENGAGEMENT
  CONVERSIONS
  APP_INSTALLS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Where ad money came from. The agency is never bound by what a client funds.
enum AdFundSource {
  CLIENT_PAID
  AGENCY_ALLOTTED
}

/// Defines which metrics a campaign captures each day. Adding a platform is a
/// row here, not a migration — same pattern as ExpenseCategory.fieldSchema.
model CampaignType {
  id       String           @id @default(cuid())
  name     String           @unique
  platform CampaignPlatform
  icon     String?

  /// Array<{ id, label, unit?, type: "count"|"currency"|"percent"|"duration", required? }>
  metricSchema   Json
  /// Array<{ id, label, formula, format? }> — computed on read, never stored
  derivedMetrics Json?

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  campaigns Campaign[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("campaign_types")
}

model Campaign {
  id        String @id @default(cuid())
  reference String @unique              // CMP-2026-0001
  name      String
  description String? @db.Text

  typeId    String       @map("type_id")
  type      CampaignType @relation(fields: [typeId], references: [id])

  objective CampaignObjective @default(LEAD_GENERATION)
  status    CampaignStatus    @default(DRAFT)

  /// Every campaign belongs to a project — that is where its budget lives.
  /// In-house marketing runs against an internal project.
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  /// Committed to this campaign. Capped by the project's available budget.
  budgetAllocated Decimal  @default(0) @map("budget_allocated") @db.Decimal(12, 2)
  dailyCap        Decimal? @map("daily_cap") @db.Decimal(12, 2)

  /// Alert thresholds. Null falls back to the global defaults.
  overspendThreshold Decimal? @map("overspend_threshold") @db.Decimal(5, 2)
  minCplTarget       Decimal? @map("min_cpl_target") @db.Decimal(12, 2)
  /// Which alerts have already fired, so the cron does not repeat itself.
  alertsSent         Json?    @map("alerts_sent")

  managerId String @map("manager_id")
  manager   User   @relation("CampaignManager", fields: [managerId], references: [id])

  createdById String @map("created_by_id")
  createdBy   User   @relation("CampaignCreator", fields: [createdById], references: [id])

  dailyStats CampaignDailyStat[]
  /// Leads credited to this campaign — the backbone of ROI.
  leads      Lead[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([startDate])
  @@map("campaigns")
}

/// One row per campaign per day. Spend and platform metrics are entered
/// manually; totals on the campaign are derived from these.
model CampaignDailyStat {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date    DateTime @db.Date
  /// Answers to the campaign type's metricSchema
  metrics Json?
  spend   Decimal  @default(0) @db.Decimal(12, 2)
  note    String?  @db.Text

  enteredById String @map("entered_by_id")
  enteredBy   User   @relation("CampaignStatAuthor", fields: [enteredById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// A day can be corrected, never duplicated.
  @@unique([campaignId, date])
  @@index([campaignId])
  @@map("campaign_daily_stats")
}

/// Ad budget pot for one project, for one month.
model AdBudgetLedger {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  periodYear  Int @map("period_year")
  periodMonth Int @map("period_month")   // 1-12

  entries AdBudgetEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, periodYear, periodMonth])
  @@index([projectId])
  @@map("ad_budget_ledgers")
}

/// Money in. Client payments and agency allotments sit side by side, tagged by
/// source, so subsidy is always visible.
model AdBudgetEntry {
  id       String         @id @default(cuid())
  ledgerId String         @map("ledger_id")
  ledger   AdBudgetLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  source    AdFundSource
  amount    Decimal  @db.Decimal(12, 2)
  taxAmount Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  note      String?  @db.Text
  reference String?                        // client payment ref / approval note

  /// Releasing funds is a spending decision, so it is attributable.
  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("AdBudgetApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")

  createdById String @map("created_by_id")
  createdBy   User   @relation("AdBudgetCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ledgerId])
  @@map("ad_budget_entries")
}

// ─── Expenses ────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  PENDING     // submitted, awaiting approval
  APPROVED    // approved, not yet reimbursed
  REJECTED
  PAID        // settled
  CANCELLED   // withdrawn by the claimant
}

enum ExpensePaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  COMPANY_CARD
  OTHER
}

// Configurable expense type. `fieldSchema` drives the claim form, exactly like
// Job.formFields drives a job application.
model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  icon        String?                          // lucide icon name

  // Array<{ id, label, type: "text"|"textarea"|"number"|"select"|"date"|"file",
  //         required?: boolean, options?: string[], placeholder?: string,
  //         computed?: { rate: number, into: "amount" } }>
  fieldSchema Json?    @map("field_schema")

  requiresReceipt Boolean  @default(true) @map("requires_receipt")
  isReimbursable  Boolean  @default(true) @map("is_reimbursable")
  // Above this, a second approver is expected. Stored now, enforced later.
  approvalLimit   Decimal? @map("approval_limit") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")

  expenses    Expense[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  reference   String        @unique            // EXP-2026-0001
  title       String
  description String?       @db.Text

  categoryId  String          @map("category_id")
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  // Answers to the category's fieldSchema
  formData    Json?         @map("form_data")
  // [{ name, url, key, mimeType, size }] — max 10 files, 5 MB each
  attachments Json?

  amount      Decimal       @db.Decimal(12, 2)
  taxAmount   Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency    Currency      @default(INR)

  expenseDate DateTime      @map("expense_date") @db.Date   // when spent
  isReimbursable Boolean    @default(true) @map("is_reimbursable")
  paymentMode ExpensePaymentMode?  @map("payment_mode")

  status      ExpenseStatus @default(PENDING)

  // Cost attribution
  projectId   String?  @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId    String?  @map("client_id")
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isBillable  Boolean  @default(false) @map("is_billable")
  invoiceId   String?  @map("invoice_id")       // set once recharged to the client

  submittedById String @map("submitted_by_id")
  submittedBy   User   @relation("ExpenseSubmitter", fields: [submittedById], references: [id])

  reviewedById  String?   @map("reviewed_by_id")
  reviewedBy    User?     @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNotes   String?   @db.Text @map("review_notes")

  paidById      String?   @map("paid_by_id")
  paidBy        User?     @relation("ExpensePayer", fields: [paidById], references: [id])
  paidAt        DateTime? @map("paid_at")
  paymentRef    String?   @map("payment_ref")   // UTR / txn id

  events      ExpenseEvent[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([submittedById])
  @@index([categoryId])
  @@index([projectId])
  @@index([expenseDate])
  @@map("expenses")
}

// Audit trail — one row per transition, same discipline as TaskFeedback.
model ExpenseEvent {
  id          String        @id @default(cuid())
  expenseId   String        @map("expense_id")
  expense     Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  action      String                            // SUBMITTED | APPROVED | REJECTED | PAID | EDITED | CANCELLED
  note        String?       @db.Text
  statusAfter ExpenseStatus @map("status_after")

  actorId     String        @map("actor_id")
  actor       User          @relation("ExpenseEventActor", fields: [actorId], references: [id])

  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([expenseId])
  @@map("expense_events")
}

// ─── Task Submission ─────────────────────────────────
// The work handed in when a task goes to review. One row per hand-in, so a
// task that bounces back for rework keeps every round instead of overwriting.

model TaskSubmission {
  id          String   @id @default(cuid())

  // Notes for the reviewer: what was done, what to look at
  note        String?  @db.Text
  // Written deliverable — copy, script, summary
  content     String?  @db.Text
  // [{ name, url, key, mimeType, size }]
  files       Json?
  // [{ label, url }] — Drive, Figma, staging, anything external
  links       Json?

  // 1 for the first hand-in, 2 after the first rework, and so on
  round       Int      @default(1)

  taskId      String   @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  submittedById String @map("submitted_by_id")
  submittedBy   User   @relation("TaskSubmitter", fields: [submittedById], references: [id])

  // Review notes raised against this specific hand-in
  feedbacks   TaskFeedback[]

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_submissions")
}

model TaskFeedback {
  id          String   @id @default(cuid())
  feedback    String?  @db.Text
  nextStep    String?  @map("next_step")
  statusAfter TaskStatus @map("status_after")

  taskId      String   @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Which hand-in this note is about. Null for plain status changes that are
  // not reviewing submitted work.
  submissionId String?        @map("submission_id")
  submission   TaskSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  // Optional pointer at one item inside that submission, so "this is wrong" can
  // name the file or link it means: { kind: "FILE"|"LINK"|"CONTENT", index, label }
  targetRef   Json?          @map("target_ref")

  givenById   String   @map("given_by_id")
  givenBy     User     @relation("TaskFeedbackGiver", fields: [givenById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([submissionId])
  @@map("task_feedbacks")
}

// ─── Milestones ──────────────────────────────────────

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?       @map("due_date")
  completedAt DateTime?       @map("completed_at")
  position    Int             @default(0)

  projectId   String          @map("project_id")
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Delivery period this belongs to. Null for records made before cycles
  /// existed, and for projects that never had one.
  cycleId     String?       @map("cycle_id")
  cycle       ProjectCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  createdById String          @map("created_by_id")
  createdBy   User            @relation("MilestoneCreator", fields: [createdById], references: [id])

  // Tasks linked to this milestone
  tasks       Task[]

  // Deliverables linked to this milestone
  deliverables DeliverableMilestone[]

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("milestones")
}

// ─── Comments (unified for Tasks, Milestones, Planning Steps) ──

enum CommentEntityType {
  TASK
  MILESTONE
  PLANNING_STEP
}

model Comment {
  id          String            @id @default(cuid())
  content     String            @db.Text
  entityType  CommentEntityType @map("entity_type")
  entityId    String            @map("entity_id")

  authorId    String            @map("author_id")
  author      User              @relation("CommentAuthor", fields: [authorId], references: [id])

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("comments")
}

// ─── Attendance & Leave Management ───────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY_FIRST      // worked only the first half of the day
  HALF_DAY_SECOND     // worked only the second half of the day
  ON_LEAVE            // approved leave covers this day
  HOLIDAY             // company-observed holiday
  WEEKEND             // weekend off
  WORK_FROM_HOME
  ON_DUTY             // external work: client visit, event, travel
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDayType {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

model Attendance {
  id             String           @id @default(cuid())
  date           DateTime         @db.Date
  userId         String           @map("user_id")
  user           User             @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  status         AttendanceStatus @default(PRESENT)
  checkInAt      DateTime?        @map("check_in_at")
  checkOutAt     DateTime?        @map("check_out_at")
  workedMinutes  Int?             @map("worked_minutes")
  notes          String?          @db.Text

  leaveRequestId String?          @map("leave_request_id")
  leaveRequest   LeaveRequest?    @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  markedById     String?          @map("marked_by_id")
  markedBy       User?            @relation("AttendanceMarker", fields: [markedById], references: [id])

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model LeaveType {
  id            String  @id @default(cuid())
  name          String  @unique
  code          String  @unique
  isPaid        Boolean @default(true) @map("is_paid")
  defaultQuota  Float?  @map("default_quota")  // null = unlimited
  color         String?
  isActive      Boolean @default(true) @map("is_active")

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation("UserLeaveBalance", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  allocated   Float     @default(0)
  used        Float     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  user         User                @relation("UserLeaveRequest", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId  String              @map("leave_type_id")
  leaveType    LeaveType           @relation(fields: [leaveTypeId], references: [id])

  fromDate     DateTime            @db.Date @map("from_date")
  toDate       DateTime            @db.Date @map("to_date")
  fromDayType  LeaveDayType        @default(FULL_DAY) @map("from_day_type")
  toDayType    LeaveDayType        @default(FULL_DAY) @map("to_day_type")
  totalDays    Float               @map("total_days")
  reason       String              @db.Text

  status       LeaveRequestStatus  @default(PENDING)
  reviewedById String?             @map("reviewed_by_id")
  reviewedBy   User?               @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?           @map("reviewed_at")
  reviewNotes  String?             @db.Text @map("review_notes")

  attendance   Attendance[]        // auto-created on approval

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([fromDate])
  @@map("leave_requests")
}

model Holiday {
  id         String   @id @default(cuid())
  name       String
  date       DateTime @db.Date @unique
  isOptional Boolean  @default(false) @map("is_optional")
  notes      String?

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("holidays")
}

// ─── Copilot ─────────────────────────────────────────────

model CopilotConversation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  title      String   @default("New Conversation")
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  messages CopilotMessage[]
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isArchived])
  @@map("copilot_conversations")
}

model CopilotMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // "user" | "assistant" | "system"
  content        String   @db.Text
  contextData    Json?    @map("context_data") // entities, page info
  createdAt      DateTime @default(now()) @map("created_at")

  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("copilot_messages")
}

// ─── Jobs / Careers ──────────────────────────────────────

enum JobStatus {
  DRAFT      // not visible on careers page
  OPEN       // accepting applications
  CLOSED     // visible but not accepting
  ARCHIVED   // hidden
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum JobWorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

model Job {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  department  String?
  location    String?
  type        JobType     @default(FULL_TIME)
  workMode    JobWorkMode @default(ON_SITE) @map("work_mode")
  description String      @db.Text
  // Optional salary range display
  salaryRange String?     @map("salary_range")

  status      JobStatus   @default(DRAFT)

  // Custom application form schema.
  // Array<{ id, label, type: "text"|"textarea"|"email"|"phone"|"number"|"select"|"file",
  //         required?: boolean, options?: string[], placeholder?: string }>
  formFields  Json?       @map("form_fields")

  createdById String      @map("created_by_id")
  createdBy   User        @relation("JobCreator", fields: [createdById], references: [id])

  applications JobApplication[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([slug])
  @@index([createdAt])
  @@map("jobs")
}

model JobApplication {
  id        String               @id @default(cuid())
  jobId     String               @map("job_id")
  job       Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Applicant basics (always captured)
  fullName  String               @map("full_name")
  email     String
  phone     String?

  // Answers to the custom form fields — { [fieldId]: value }.
  // File fields store { url, name, size } objects.
  answers   Json?

  status    JobApplicationStatus @default(NEW)
  notes     String?              @db.Text

  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

// ─── Payroll & KPI ───────────────────────────────────────

enum PayrollStatus {
  DRAFT       // auto-computed, editable
  FINALIZED   // locked, ready to pay
  PAID        // disbursed
}

// Single-row config (id = "default"). Weights + bonus slabs + attendance policy.
model KpiConfig {
  id                String  @id @default("default")

  // Metric weights (relative; normalized at compute). Non-negative.
  weightAttendance  Float   @default(30) @map("weight_attendance")
  weightCompletion  Float   @default(25) @map("weight_completion")
  weightOnTime      Float   @default(20) @map("weight_on_time")
  weightReviewPass  Float   @default(15) @map("weight_review_pass")
  weightRework      Float   @default(10) @map("weight_rework")

  // Bonus slabs: Array<{ minScore, maxScore, bonusAmount }> — bonus in INR.
  bonusSlabs        Json    @default("[]") @map("bonus_slabs")

  // Attendance statuses that count as a full "present" day for the ratio.
  presentStatuses   String[] @default(["PRESENT", "WORK_FROM_HOME", "ON_DUTY"]) @map("present_statuses")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("kpi_config")
}

model PayrollRecord {
  id              String        @id @default(cuid())

  userId          String        @map("user_id")
  user            User          @relation("PayrollUser", fields: [userId], references: [id], onDelete: Cascade)

  year            Int
  month           Int           // 1-12

  // Snapshots at generation time
  basePay         Decimal       @default(0) @db.Decimal(12, 2) @map("base_pay")
  kpiScore        Float         @default(0) @map("kpi_score")   // 0-100

  // Per-metric breakdown: { attendance, completion, onTime, reviewPass, rework, raw:{...} }
  breakdown       Json?

  computedBonus   Decimal       @default(0) @db.Decimal(12, 2) @map("computed_bonus")
  manualAdjustment Decimal      @default(0) @db.Decimal(12, 2) @map("manual_adjustment")
  netPay          Decimal       @default(0) @db.Decimal(12, 2) @map("net_pay")

  status          PayrollStatus @default(DRAFT)
  notes           String?       @db.Text
  paidAt          DateTime?     @map("paid_at")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([userId, year, month])
  @@index([year, month])
  @@index([status])
  @@map("payroll_records")
}

// ─── Deliverables ────────────────────────────────────────
// Client-facing outputs of a project: files, links, or plain text.
// Optionally linked to a milestone / planning step / task.

enum DeliverableStatus {
  IN_PROGRESS
  IN_REVIEW
  CHANGES_REQUESTED
  COMPLETED
}

enum DeliverableFeedbackType {
  APPROVED
  CHANGES_REQUESTED
  COMMENT
}

model Deliverable {
  id              String            @id @default(cuid())
  title           String
  description     String?           @db.Text

  // Free-form text body (used when the deliverable is just written content)
  content         String?           @db.Text
  // Attachments: Array<{ name, url, key?, mimeType?, size? }>
  files           Json?
  // External links: Array<{ label, url }>
  links           Json?

  status          DeliverableStatus @default(IN_PROGRESS)
  // When true the client is expected to review + respond
  requiresFeedback Boolean          @default(false) @map("requires_feedback")
  // Hidden from the client portal until published
  isPublished     Boolean           @default(false) @map("is_published")
  publishedAt     DateTime?         @map("published_at")

  projectId       String            @map("project_id")
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional links into the plan (many-to-many)
  milestones      DeliverableMilestone[]
  planningSteps   DeliverablePlanningStep[]
  tasks           DeliverableTask[]

  createdById     String            @map("created_by_id")
  createdBy       User              @relation("DeliverableCreator", fields: [createdById], references: [id])

  feedbacks       DeliverableFeedback[]

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@map("deliverables")
}

model DeliverableFeedback {
  id            String                  @id @default(cuid())
  deliverableId String                  @map("deliverable_id")
  deliverable   Deliverable             @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  type          DeliverableFeedbackType @default(COMMENT)
  message       String?                 @db.Text

  givenById     String                  @map("given_by_id")
  givenBy       User                    @relation("DeliverableFeedbackAuthor", fields: [givenById], references: [id])

  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([deliverableId])
  @@map("deliverable_feedbacks")
}

// ─── Deliverable ↔ plan links (many-to-many) ─────────────

model DeliverableMilestone {
  id            String      @id @default(cuid())
  deliverableId String      @map("deliverable_id")
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  milestoneId   String      @map("milestone_id")
  milestone     Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, milestoneId])
  @@index([deliverableId])
  @@index([milestoneId])
  @@map("deliverable_milestones")
}

model DeliverablePlanningStep {
  id             String       @id @default(cuid())
  deliverableId  String       @map("deliverable_id")
  deliverable    Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  planningStepId String       @map("planning_step_id")
  planningStep   PlanningStep @relation(fields: [planningStepId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, planningStepId])
  @@index([deliverableId])
  @@index([planningStepId])
  @@map("deliverable_planning_steps")
}

model DeliverableTask {
  id            String      @id @default(cuid())
  deliverableId String      @map("deliverable_id")
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  taskId        String      @map("task_id")
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, taskId])
  @@index([deliverableId])
  @@index([taskId])
  @@map("deliverable_tasks")
}

/// One billing/delivery period of a project.
///
/// Retainer work repeats every month: the same milestones, steps and tasks come
/// round again. Grouping them into a cycle keeps each month's board clean, lets
/// a finished month be reviewed on its own, and makes "start next month" a copy
/// rather than a re-type.
///
/// One-time projects get a single cycle, so nothing about them changes.
model ProjectCycle {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Human label for the period — "September 2026", "Q3 2026".
  label       String
  periodStart DateTime @map("period_start") @db.Date
  /// Inclusive last day of the period.
  periodEnd   DateTime @map("period_end") @db.Date

  status ProjectCycleStatus @default(ACTIVE)

  /// The cycle this one was cloned from, so a carried-over plan is traceable.
  clonedFromId String?       @map("cloned_from_id")
  clonedFrom   ProjectCycle? @relation("CycleClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       ProjectCycle[] @relation("CycleClone")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ProjectCycleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  milestones    Milestone[]
  planningSteps PlanningStep[]
  tasks         Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, periodStart])
  @@index([projectId])
  @@index([status])
  @@map("project_cycles")
}

enum ProjectCycleStatus {
  ACTIVE
  CLOSED
}
